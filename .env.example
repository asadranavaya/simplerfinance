# Copy the variables you need into .env. Never commit the populated .env file.

NODE_ENV=development
PORT=3001
# Generate with: openssl rand -hex 32
JWT_SECRET=
ALLOW_REGISTRATION=false

# Optional paths. Defaults are data/budget.db and data/service-logs.db.
BUDGET_DB_PATH=./data/budget.db
SERVICE_LOG_DB_PATH=./data/service-logs.db

# Required for account-verification and MFA emails.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Exactly 32 random bytes encoded as 64 hexadecimal characters.
# Generate once for a deployment and back it up securely. Losing or changing
# this key makes stored SimpleFIN access URLs unreadable.
SIMPLEFIN_ENCRYPTION_KEY=

# Local MaxMind GeoLite2 City database used for approximate IP locations in
# the admin dashboard. Download GeoLite2-City.mmdb and keep it outside Git.
MAXMIND_CITY_DB_PATH=

# Master key used only to wrap the unique random data-encryption key generated
# for each customer. In production, inject this from a secret manager. When it
# is omitted, the single-host app creates .secrets/customer-data-master-key
# with mode 0600. Back up that file separately from the database.
CUSTOMER_DATA_MASTER_KEY=
